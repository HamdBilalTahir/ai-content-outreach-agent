# ═══════════════════════════════════════════════════════════════════════════════
# OUTBOUND AGENT (outbound/)
#
# All of the following are OPTIONAL and unset by default. The outbound flow loads and runs its
# deterministic gating (business hours, opt-outs, DNC, dispatch claim, cadence, pacing) with none
# of them configured — an unconfigured integration throws OutboundIntegrationNotConfigured at its
# own call site rather than at import. Fill in a block to activate that integration.
# ═══════════════════════════════════════════════════════════════════════════════

# ── LLM providers (llm/ask.ts routes between them; LLM_PROVIDER is the fallback) ──
# LLM_PROVIDER=bedrock
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_REGION=us-east-1
# PRODUCTION_GROQ_CHAT_HISTORY_LIMIT=60

# ── Voice (ElevenLabs agent + Twilio trunk) ──
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_WEBHOOK_SECRET=
# ELEVENLABS_OUTBOUND_WEBHOOK_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Email (SendGrid send + event webhook + CAN-SPAM identity) ──
# SENDGRID_API_KEY=
# SENDGRID_WEBHOOK_PUBLIC_KEY=
# SENDGRID_WEBHOOK_ALLOW_UNSIGNED=false
# EMAIL_SANDBOX_MODE=false
# COMPANY_NAME=Auto Acquire AI
# COMPANY_POSTAL_ADDRESS=
# UNSUB_BASE_URL=
# UNSUB_MAILTO=
# UNSUB_SIGNING_KEY_V1=

# ── CRM (HubSpot) ──
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# ── Compliance / enrichment providers ──
# DNCSCRUB_LOGIN_ID=
# VERIFY_PROVIDER=
# VERIFY_API_KEY=
# VERIFY_CACHE_TTL_DAYS=30
# ALLOW_CATCH_ALL=false
# SCRAPER_PROVIDER=
# SCRAPER_API_KEY=
# SCRAPER_URL_TEMPLATE=
# SCRAPER_ENGINE=
# SCRAPER_EXTRA=

# ── Public base URL used to build webhook + unsubscribe links ──
# BASE_URL=

# ── Cron / dispatch tuning ──
# OUTBOUND_MAX_TASKS_PER_TICK=10
# OUTBOUND_TASK_LOOKBACK_MIN=20160
# OUTBOUND_TASK_DISPATCH_CLAIM=1
# OUTBOUND_STALLED_SWEEP_MAX=20
# OUTBOUND_STALLED_GRACE_MIN=60
# OUTBOUND_REVIEW_CHAT_ENABLED=1

# ── Cadence / dial guards ──
# OUTBOUND_MAX_EMAIL_FOLLOWUPS=4
# OUTBOUND_MAX_CALL_FOLLOWUPS=4
# OUTBOUND_DIAL_RECENCY_FLOOR_MIN=30
# OUTBOUND_DIAL_AWAITING_REVIEW_MAX_MIN=360
# OUTBOUND_STALE_PENDING_CALL_MIN=25
# OUTBOUND_TEST_PHONE_FIRST=1
# OUTBOUND_TERMINAL_BLOCK_SHORTCIRCUIT=1

# ── Voice concurrency ──
# OUTBOUND_MAX_CONCURRENT_VOICE_CALLS=5
# OUTBOUND_VOICE_SLOT_TTL_MINUTES=20

# ── Email pacing / reputation ramp ──
# OUTBOUND_EMAILS_PER_HOUR=60
# EMAILS_PER_RECIPIENT_PER_DAY=3
# DOMAIN_DAILY_CAP=50
# DOMAIN_START_DATE=
# EMAIL_REACTIVATION_POLICY_ENABLED=false
# REPLY_FRESHNESS_HOURS=168
# INBOUND_NUDGE_FIRST_DELAY_HOURS=4
# INBOUND_NUDGE_OFFSETS_DAYS=1,3,5,7
